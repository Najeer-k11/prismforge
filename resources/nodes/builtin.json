    {
      "id": "output.surface",
      "title": "Surface Output",
      "category": "Output",
      "description": "Physically based surface lit by two fixed preview lights.",
      "role": "output",
      "inputs": [
        {
          "id": "baseColor",
          "type": "vec3",
          "label": "Base colour",
          "default": [
            0.8,
            0.8,
            0.8
          ],
          "color": true
        },
        {
          "id": "roughness",
          "type": "float",
          "label": "Roughness",
          "default": [
            0.5
          ]
        },
        {
          "id": "metallic",
          "type": "float",
          "label": "Metallic",
          "default": [
            0.0
          ]
        },
        {
          "id": "emission",
          "type": "vec3",
          "label": "Emission",
          "default": [
            0,
            0,
            0
          ],
          "color": true
        },
        {
          "id": "alpha",
          "type": "float",
          "label": "Alpha",
          "default": [
            1.0
          ]
        }
      ],
      "outputs": [],
      "functions": "vec4 pf_shadeSurface(vec3 baseColor, float roughness, float metallic, vec3 emission, float alpha)\n{\n    const float pi = 3.14159265;\n    vec3 n = normalize(vWorldNormal);\n    vec3 v = normalize(uCameraPosition - vWorldPosition);\n    float r = clamp(roughness, 0.04, 1.0);\n    float a2 = r * r * r * r;\n    float m = clamp(metallic, 0.0, 1.0);\n    vec3 f0 = mix(vec3(0.04), baseColor, m);\n    vec3 diffuseColor = baseColor * (1.0 - m);\n    vec3 lightDirs[2] = vec3[2](normalize(vec3(0.6, 0.8, 0.4)), normalize(vec3(-0.7, 0.2, -0.5)));\n    vec3 lightColors[2] = vec3[2](vec3(1.0, 0.97, 0.92) * 4.0, vec3(0.35, 0.45, 0.6) * 1.5);\n    vec3 color = diffuseColor * 0.08 + f0 * 0.04;\n    for (int i = 0; i < 2; ++i) {\n        vec3 l = lightDirs[i];\n        vec3 h = normalize(l + v);\n        float nl = max(dot(n, l), 0.0);\n        float nh = max(dot(n, h), 0.0);\n        float nv = max(dot(n, v), 1.0e-4);\n        float vh = max(dot(v, h), 0.0);\n        float dd = nh * nh * (a2 - 1.0) + 1.0;\n        float d = a2 / (pi * dd * dd);\n        float k = (r + 1.0) * (r + 1.0) / 8.0;\n        float g = (nl / (nl * (1.0 - k) + k)) * (nv / (nv * (1.0 - k) + k));\n        vec3 f = f0 + (1.0 - f0) * pow(1.0 - vh, 5.0);\n        vec3 specular = d * g * f / max(4.0 * nl * nv, 1.0e-4);\n        color += ((1.0 - f) * diffuseColor / pi + specular) * lightColors[i] * nl;\n    }\n    color += emission;\n    color = color / (1.0 + color);\n    return vec4(pow(color, vec3(1.0 / 2.2)), clamp(alpha, 0.0, 1.0));\n}",
      "main": "fragColor = pf_shadeSurface({baseColor}, {roughness}, {metallic}, {emission}, {alpha});"
    },
    {
      "id": "output.unlit",
      "title": "Unlit Output",
      "category": "Output",
      "description": "Writes the colour directly (gamma-encoded), without lighting.",
