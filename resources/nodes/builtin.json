          "label": "Radius/Angle"
        }
      ],
      "functions": "vec2 pf_polarUV(vec2 uv, vec2 center)\n{\n    vec2 d = uv - center;\n    return vec2(length(d) * 2.0, atan(d.y, d.x) / 6.28318530718 + 0.5);\n}"
    },
    {
      "id": "uv.checker",
      "title": "Checkerboard",
