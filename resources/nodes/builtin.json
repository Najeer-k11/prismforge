    {
      "id": "math.remap",
      "title": "Remap",
      "category": "Math",
      "description": "Maps X from [In min, In max] to [Out min, Out max].",
      "inputs": [
        {
          "id": "x",
          "type": "T",
          "label": "X",
          "default": [
            0.5
          ]
        },
        {
          "id": "inMin",
          "type": "float",
          "label": "In min",
          "default": [
            0.0
          ]
        },
        {
          "id": "inMax",
          "type": "float",
          "label": "In max",
          "default": [
            1.0
          ]
        },
        {
          "id": "outMin",
          "type": "float",
          "label": "Out min",
          "default": [
            0.0
          ]
        },
        {
          "id": "outMax",
          "type": "float",
          "label": "Out max",
          "default": [
            1.0
          ]
        }
      ],
      "outputs": [
        {
          "id": "out",
          "type": "T",
          "expr": "{outMin} + ({x} - {inMin}) * (({outMax} - {outMin}) / ({inMax} - {inMin}))",
          "label": "Result"
        }
      ]
    },
