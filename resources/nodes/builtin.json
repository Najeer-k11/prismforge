    {
      "id": "color.hsv_to_rgb",
      "title": "HSV to RGB",
      "category": "Colour",
      "description": "Hue, saturation and value in [0, 1].",
      "inputs": [
        {
          "id": "hsv",
          "type": "vec3",
          "label": "HSV",
          "default": [
            0,
            1,
            1
          ]
        }
      ],
      "outputs": [
        {
          "id": "out",
          "type": "vec3",
          "expr": "pf_hsvToRgb({hsv})",
          "label": "RGB"
        }
      ],
      "functions": "vec3 pf_hsvToRgb(vec3 c)\n{\n    vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);\n    return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);\n}"
    },
    {
      "id": "color.rgb_to_hsv",
      "title": "RGB to HSV",
      "category": "Colour",
      "inputs": [
        {
          "id": "rgb",
          "type": "vec3",
          "label": "RGB",
          "default": [
            1,
            0,
            0
          ],
          "color": true
        }
      ],
      "outputs": [
        {
          "id": "out",
          "type": "vec3",
          "expr": "pf_rgbToHsv({rgb})",
          "label": "HSV"
        }
      ],
      "functions": "vec3 pf_rgbToHsv(vec3 c)\n{\n    vec4 k = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);\n    vec4 p = mix(vec4(c.bg, k.wz), vec4(c.gb, k.xy), step(c.b, c.g));\n    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));\n    float d = q.x - min(q.w, q.y);\n    float e = 1.0e-10;\n    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);\n}"
    },
