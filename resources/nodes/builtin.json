          "expr": "pf_rotateUV({uv}, {center}, {angle})",
          "label": "UV"
        }
      ],
      "functions": "vec2 pf_rotateUV(vec2 uv, vec2 center, float angle)\n{\n    float s = sin(angle);\n    float c = cos(angle);\n    uv -= center;\n    return vec2(c * uv.x - s * uv.y, s * uv.x + c * uv.y) + center;\n}"
    },
    {
      "id": "uv.polar",
      "title": "Polar Coordinates",
      "category": "UV",
      "description": "x = distance from centre (x2), y = angle in [0, 1].",
