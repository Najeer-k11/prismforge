    {
      "id": "noise.value",
      "title": "Value Noise",
      "category": "Noise",
      "description": "Smooth value noise in [0, 1].",
      "inputs": [
        {
          "id": "uv",
          "type": "vec2",
          "label": "UV",
          "defaultExpr": "vUV"
        },
        {
          "id": "scale",
          "type": "float",
          "label": "Scale",
          "default": [
            8.0
          ]
        }
      ],
      "outputs": [
        {
          "id": "out",
          "type": "float",
          "expr": "pf_valueNoise({uv} * {scale})",
          "label": "Noise"
        }
      ],
      "functions": "float pf_valueHash(vec2 p)\n{\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(p.x * p.y);\n}\n\nfloat pf_valueNoise(vec2 p)\n{\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    vec2 u = f * f * (3.0 - 2.0 * f);\n    float a = pf_valueHash(i);\n    float b = pf_valueHash(i + vec2(1.0, 0.0));\n    float c = pf_valueHash(i + vec2(0.0, 1.0));\n    float d = pf_valueHash(i + vec2(1.0, 1.0));\n    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}"
    },
    {
      "id": "noise.gradient",
      "title": "Gradient Noise",
      "category": "Noise",
      "description": "Perlin-style gradient noise in roughly [0, 1].",
      "inputs": [
        {
          "id": "uv",
          "type": "vec2",
          "label": "UV",
          "defaultExpr": "vUV"
        },
        {
          "id": "scale",
          "type": "float",
          "label": "Scale",
          "default": [
            8.0
          ]
        }
      ],
      "outputs": [
        {
          "id": "out",
          "type": "float",
          "expr": "pf_gradientNoise({uv} * {scale}) * 0.5 + 0.5",
          "label": "Noise"
        }
      ],
      "functions": "vec2 pf_gradientDir(vec2 p)\n{\n    p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));\n    return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);\n}\n\nfloat pf_gradientNoise(vec2 p)\n{\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    vec2 u = f * f * (3.0 - 2.0 * f);\n    float a = dot(pf_gradientDir(i), f);\n    float b = dot(pf_gradientDir(i + vec2(1.0, 0.0)), f - vec2(1.0, 0.0));\n    float c = dot(pf_gradientDir(i + vec2(0.0, 1.0)), f - vec2(0.0, 1.0));\n    float d = dot(pf_gradientDir(i + vec2(1.0, 1.0)), f - vec2(1.0, 1.0));\n    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}"
    },
    {
      "id": "noise.fbm",
      "title": "Fractal Noise",
      "category": "Noise",
      "description": "Fractal Brownian motion: summed gradient noise octaves (1-10).",
      "inputs": [
        {
          "id": "uv",
          "type": "vec2",
          "label": "UV",
          "defaultExpr": "vUV"
        },
        {
          "id": "scale",
          "type": "float",
          "label": "Scale",
          "default": [
            4.0
          ]
        },
        {
          "id": "octaves",
          "type": "float",
          "label": "Octaves",
          "default": [
            5.0
          ]
        }
      ],
      "outputs": [
        {
          "id": "out",
          "type": "float",
          "expr": "pf_fbm({uv} * {scale}, {octaves})",
          "label": "Noise"
        }
      ],
      "functions": "vec2 pf_fbmDir(vec2 p)\n{\n    p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));\n    return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);\n}\n\nfloat pf_fbmNoise(vec2 p)\n{\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    vec2 u = f * f * (3.0 - 2.0 * f);\n    float a = dot(pf_fbmDir(i), f);\n    float b = dot(pf_fbmDir(i + vec2(1.0, 0.0)), f - vec2(1.0, 0.0));\n    float c = dot(pf_fbmDir(i + vec2(0.0, 1.0)), f - vec2(0.0, 1.0));\n    float d = dot(pf_fbmDir(i + vec2(1.0, 1.0)), f - vec2(1.0, 1.0));\n    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\n\nfloat pf_fbm(vec2 p, float octaves)\n{\n    int count = int(clamp(octaves, 1.0, 10.0));\n    float sum = 0.0;\n    float amplitude = 0.5;\n    float norm = 0.0;\n    for (int k = 0; k < 10; ++k) {\n        if (k >= count)\n            break;\n        sum += amplitude * pf_fbmNoise(p);\n        norm += amplitude;\n        p = p * 2.0 + vec2(17.0, 9.0);\n        amplitude *= 0.5;\n    }\n    return sum / norm * 0.5 + 0.5;\n}"
    },
    {
      "id": "noise.voronoi",
      "title": "Voronoi",
      "category": "Noise",
      "description": "Distance to the nearest cell point.",
      "inputs": [
        {
          "id": "uv",
          "type": "vec2",
          "label": "UV",
          "defaultExpr": "vUV"
        },
        {
          "id": "scale",
