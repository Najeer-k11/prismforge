          "label": "Scale",
          "default": [
            8.0
          ]
        }
      ],
      "outputs": [
        {
          "id": "out",
          "type": "float",
          "expr": "pf_voronoi({uv} * {scale})",
          "label": "Distance"
        }
      ],
      "functions": "vec2 pf_voronoiHash(vec2 p)\n{\n    p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));\n    return fract(sin(p) * 43758.5453);\n}\n\nfloat pf_voronoi(vec2 p)\n{\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    float d = 8.0;\n    for (int y = -1; y <= 1; ++y) {\n        for (int x = -1; x <= 1; ++x) {\n            vec2 g = vec2(float(x), float(y));\n            d = min(d, length(g + pf_voronoiHash(i + g) - f));\n        }\n    }\n    return d;\n}"
    },
    {
      "id": "material.fresnel",
      "title": "Fresnel",
      "category": "Material",
